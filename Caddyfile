# Caddy automatically provisions and renews HTTPS for real domains.
# Set DOMAIN in your .env (e.g. DOMAIN=research.example.com).
# For local testing without a domain, DOMAIN=localhost serves plain HTTP.
{$DOMAIN:localhost} {
	encode gzip

	# Caddy streams SSE responses out of the box; flush_interval=-1 disables
	# buffering entirely so agent tokens reach the browser as they are produced.
	reverse_proxy app:8000 {
		flush_interval -1
	}
}

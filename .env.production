# Copy to `.env` at the repository root, then fill in real values:
#   cp .env.production .env

# ── LLM ───────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── MySQL ─────────────────────────────────────────────────────────────────────
# 两个不同的密码：root 仅用于运维与迁移，app 使用最小权限账号（仅能操作本库）
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_USER=zhiyan
MYSQL_PASSWORD=change-this-app-password

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_long_random_secret
# Set true once HTTPS is active (Caddy provides it for real domains).
AUTH_COOKIE_SECURE=true
AUTH_ADMIN_EMAILS=1539570130@qq.com
# deploy.sh generates DEFAULT_ADMIN_PASSWORD when it is empty. Never commit a
# real production password to this file.
DEFAULT_ADMIN_EMAIL=1539570130@qq.com
DEFAULT_ADMIN_PASSWORD=

# ── Domain & CORS ─────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
# Same-origin deployments can leave this empty; list origins explicitly otherwise.
CORS_ORIGINS=https://your-domain.com

# ── SMTP (QQ) ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=1539570130@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM_EMAIL=1539570130@qq.com
SMTP_FROM_NAME=知研 Agent
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── Research / search ─────────────────────────────────────────────────────────
SEARCH_BACKEND=web_only
TAVILY_API_KEY=tvly-dev-xxxx

# ── Embeddings (downloaded on first boot, cached in the data volume) ─────────
EMBED_LOCAL_FILES_ONLY=false
HF_ENDPOINT=https://hf-mirror.com

# ── TLS ──────────────────────────────────────────────────────────────────────
# 生产环境保持 false（校验证书）。仅本地被 TLS 拦截代理挡住时才临时设 true。
SSL_NO_VERIFY=false

# ── Deep Research 费用上限 ──────────────────────────────────────────────────
# 0 = 不限制；公开部署务必设置。token 上限已提供硬保护，
# 仅当 DEEP_RESEARCH_*_PER_MILLION_USD 价格填真实值后，费用上限才真正生效。
DEEP_RESEARCH_MAX_COST_USD=5

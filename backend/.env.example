DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepResearch role models (omitted roles fall back to DEEPSEEK_MODEL)
DEEP_RESEARCH_DRAFT_MODEL=deepseek-v4-flash
DEEP_RESEARCH_SUPERVISOR_MODEL=deepseek-v4-flash
DEEP_RESEARCH_RESEARCHER_MAIN_MODEL=deepseek-v4-flash
# researcher_main 使用 Responses API；摘要和压缩仍使用 Chat Completions
DEEP_RESEARCH_RESEARCHER_MAIN_API=responses
DEEP_RESEARCH_RESEARCHER_SUMMARIZER_MODEL=deepseek-v4-flash
DEEP_RESEARCH_RESEARCHER_COMPRESSOR_MODEL=deepseek-v4-flash
DEEP_RESEARCH_RED_TEAM_MODEL=deepseek-v4-pro
DEEP_RESEARCH_EVALUATOR_MODEL=deepseek-v4-flash
DEEP_RESEARCH_WRITER_MODEL=deepseek-v4-pro

QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Set true after the embedding model has been downloaded, or in offline environments.
EMBED_LOCAL_FILES_ONLY=false

OBSIDIAN_VAULT=/Users/yourname/Documents/MyKnowledge/Videos

# Deep Research(可选 · 仅使用「深度分析-Deep 模式」时需要)
# SEARCH_BACKEND  : kb_only(默认,仅查个人知识库) / web_only(仅 Tavily 联网) / hybrid(两者并行融合)
SEARCH_BACKEND=kb_only
TAVILY_API_KEY=tvly-dev-xxxx
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=3
TAVILY_TOPIC=general
TAVILY_TIMEOUT_SECONDS=60
TAVILY_LLM_SUMMARIZE=false

CN_FUND_ENABLE_WEB_SEARCH=true
CN_FUND_ANNUAL_RISK_FREE_RATE=0.015
# 留空表示必须由产品披露、ETF 跟踪指数或用户明确指定
CN_FUND_DEFAULT_BENCHMARK=
DEEP_RESEARCH_MAX_ITERATIONS=15
DEEP_RESEARCH_LLM_TIMEOUT_SECONDS=120
DEEP_RESEARCH_EVALUATOR_MAX_TOKENS=2048
DEEP_RESEARCH_MAX_CONCURRENT=2
DEEP_RESEARCH_MIN_REPAIR_SCORE=6.0
DEEP_RESEARCH_RED_TEAM_MAX=3
DEEP_RESEARCH_MAX_INPUT_TOKENS=240000000
DEEP_RESEARCH_MAX_OUTPUT_TOKENS=600000000
DEEP_RESEARCH_MAX_TOOL_CALLS=200
# 0 表示不设置费用硬上限；价格按实际模型供应商账单填写（USD / 1M tokens）
DEEP_RESEARCH_MAX_COST_USD=0
DEEP_RESEARCH_FLASH_INPUT_PER_MILLION_USD=0
DEEP_RESEARCH_FLASH_OUTPUT_PER_MILLION_USD=0
DEEP_RESEARCH_PRO_INPUT_PER_MILLION_USD=0
DEEP_RESEARCH_PRO_OUTPUT_PER_MILLION_USD=0
DEEP_RESEARCH_SUB_MAX_STEPS=5
# MySQL business data (memory and research history)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=multi_agent_platform
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
DEFAULT_USER_ID=local-user
MEMORY_STORAGE_BACKEND=mysql
MEMORY_REFLECTION_THRESHOLD=50
MEMORY_OBSERVATION_TTL_DAYS=30
MEMORY_INFERRED_TTL_DAYS=180
MEMORY_RETRIEVAL_LIMIT=12
MEMORY_CONTEXT_MAX_CHARS=3000
